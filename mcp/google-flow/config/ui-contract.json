  "picker": { "uploading": "^Uploading " },
  "tile": { "assetInfo": "Created \\w+ \\d", "noRetry": "polic|violat|safety|refus|prohibit|not allowed|inappropriate|can.t (generate|create)|unable to (generate|create)" },
  "settingsGroups": {
    "kind": { "has": "settings.kind.image" },
    "image.ratio": { "has": "settings.ratio.1:1" },
    "image.count": { "has": "settings.count.x1" },
    "video.ratio": { "has": "settings.ratio.16:9", "hasNot": "settings.ratio.1:1" },
    "video.count": { "has": "settings.count.x1" },
    "video.resolution": { "has": "settings.resolution.720p" },
    "video.duration": { "has": "settings.duration.4s" },
    "video.mode": { "has": "settings.mode.frames" }
  },
  "blocks": {
    "toastDismiss": "Dismiss",
    "rules": [
      { "code": "NOT_LOGGED_IN", "url": "^https://accounts\\.google\\.com/" },
      { "code": "MANUAL_VERIFICATION_REQUIRED", "text": "not a robot|verify (that )?you('re| are) human|complete the captcha", "anywhere": true },
      { "code": "WAF_BLOCK", "text": "unusual (traffic|activity)", "anywhere": true },
      { "code": "GOOGLE_LIMIT_REACHED", "text": "reached your (daily |monthly )?(limit|quota)|quota exceeded|not enough credits|out of credits" }
    ]
  }
}
