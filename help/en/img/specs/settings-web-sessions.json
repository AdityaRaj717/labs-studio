{
  "page": "settings",
  "features": "flow",
  "size": [
    1180,
    860
  ],
  "setup": "settings_web",
  "grab": "page",
  "callouts": [
    {
      "n": 1,
      "target": [
        "tabs/currentWidget/PathEdit{key=web.chrome_path}",
        "tabs/currentWidget/PathEdit{key=web.profile_dir}",
        "tabs/currentWidget/PathEdit{key=web.diag_dir}"
      ],
      "label": "Browser"
    },
    {
      "n": 2,
      "target": [
        "tabs/currentWidget/PathEdit{key=web.flow_mcp_dir}",
        "tabs/currentWidget/QLineEdit{text=node}"
      ],
      "label": "MCP folder and Node.js"
    },
    {
      "n": 3,
      "target": [
        "tabs/currentWidget/QDoubleSpinBox[0]",
        "tabs/currentWidget/QDoubleSpinBox[1]",
        "tabs/currentWidget/rows/flow/cap"
      ],
      "label": "Pacing",
      "split": true
    },
    {
      "n": 4,
      "target": "tabs/currentWidget/rows/flow/btn_launch",
      "label": "Launch browser"
    },
    {
      "n": 5,
      "target": "tabs/currentWidget/rows/flow/btn_check",
      "label": "Check login"
    },
    {
      "n": 6,
      "target": "tabs/currentWidget/rows/flow/btn_diag",
      "label": "Diagnose page"
    }
  ],
  "gutter": 220
}
